<mxfile host="app.diagrams.net">
  <diagram name="Error Flow" id="error-flow">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="e" value="Error Occurs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8e0de;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="130" height="40"/>
        </mxCell>
        <mxCell id="d" value="Diagnose via CLI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="260" y="40" width="130" height="40"/>
        </mxCell>
        <mxCell id="f" value="Fix Cause" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="260" y="120" width="130" height="40"/>
        </mxCell>
        <mxCell id="r" value="Re-run" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="260" y="200" width="130" height="40"/>
        </mxCell>
        <mxCell id="v" value="Verify" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="260" y="280" width="130" height="40"/>
        </mxCell>
        <mxCell id="done" value="Done" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f0d9;strokeColor=#5e7a47;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="260" y="360" width="130" height="40"/>
        </mxCell>
        <mxCell id="cl" value="Check Error Logs (Module 11)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="140" width="140" height="40"/>
        </mxCell>
        <mxCell id="kn" value="Known Issue?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="100" y="240" width="120" height="60"/>
        </mxCell>
        <mxCell id="kf" value="Apply Known Fix" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="360" width="140" height="40"/>
        </mxCell>
        <mxCell id="e-d" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b85450;entryX=0;entryY=0.5;" edge="1" parent="1" source="e" target="d">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="d-f" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6c8ebf;" edge="1" parent="1" source="d" target="f">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="f-r" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#82b366;" edge="1" parent="1" source="f" target="r">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="r-v" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#82b366;" edge="1" parent="1" source="r" target="v">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="v-done" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#82b366;" edge="1" parent="1" source="v" target="done">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-cl" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d6b656;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="e" target="cl">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="cl-kn" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d6b656;" edge="1" parent="1" source="cl" target="kn">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="kn-kf" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#82b366;exitX=0;exitY=0.5;fontSize=11;" edge="1" parent="1" source="kn" target="kf">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="kn-d" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6c8ebf;exitX=1;exitY=0.5;fontSize=11;" edge="1" parent="1" source="kn" target="d">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="kf-done" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#82b366;" edge="1" parent="1" source="kf" target="done">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
