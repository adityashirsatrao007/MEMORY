#!/usr/bin/env python3
"""Search skills via vector embeddings (semantic search).
Usage: skill-vector-search <query> [top_k]

Combines vector similarity with keyword matching for best results.
Falls back to skill-find (ripgrep) if vector DB has no skills indexed."""
import sys
import os
import chromadb

MEMORY_ROOT = os.environ.get("MEMORY_ROOT", os.path.expanduser("~/Desktop/Projects/MEMORY"))
DB = os.path.join(MEMORY_ROOT, "memory", "vector_db")
SKILL_DIR = os.path.join(MEMORY_ROOT, ".agents", "skills")

query = sys.argv[1] if len(sys.argv) > 1 else ""
top_k = int(sys.argv[2]) if len(sys.argv) > 2 else 10

if not query:
    print("Usage: skill-vector-search <query> [top_k]")
    sys.exit(1)

c = chromadb.PersistentClient(path=DB)
col = c.get_or_create_collection(name="antigravity_memory")

# Vector search over all chunks (modules + skills)
results = col.query(
    query_texts=[query],
    n_results=top_k,
    where={"type": "skill"}  # Filter to skills only
)

if not results["documents"][0]:
    print("  No vector results. Falling back to skill-find...")
    os.system(f'skill-find "{query}" {top_k}')
    sys.exit(0)

print(f"  Vector search results for: \"{query}\"\n")
for doc, meta, dist in zip(results["documents"][0], results["metadatas"][0], results["distances"][0]):
    skill_name = meta.get('skill_name', meta.get('section', '?'))
    relevance = max(0, 1 - dist)  # Convert distance to relevance score (0-1)
    print(f"  [{relevance:.0%}] {skill_name}")
    for line in doc.strip().split('\n')[:3]:
        if line.strip():
            print(f"    {line[:120]}")
    print()

print(f"  Found {len(results['documents'][0])} skills. Load with:")
print(f"    bat --line-range :80 \"$MEMORY_ROOT/.agents/skills/<name>/SKILL.md\"")
