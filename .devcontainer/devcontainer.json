{
  "name": "MEMORY Agent Environment",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/python:1": { "version": "3.12" },
    "ghcr.io/devcontainers/features/node:1": { "version": "20" },
    "ghcr.io/devcontainers/features/go:1": { "version": "1.22" },
    "ghcr.io/devcontainers/features/rust:1": {},
    "ghcr.io/devcontainers/features/git:1": {}
  },
  "postCreateCommand": "bash setup.sh && make seed",
  "postAttachCommand": "source .venv/bin/activate && export MEMORY_NON_COMMERCIAL=1",
  "customizations": {
    "vscode": {
      "extensions": [
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "bradlc.vscode-tailwindcss",
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint",
        "eamodio.gitlens"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
        "files.exclude": {
          "**/__pycache__": true,
          "**/.pytest_cache": true,
          "**/node_modules": true
        }
      }
    }
  },
  "forwardPorts": [8082, 8083, 5173],
  "remoteEnv": {
    "MEMORY_ROOT": "/workspace/MEMORY",
    "MEMORY_NON_COMMERCIAL": "1",
    "MEMORY_MODE": "lazy"
  },
  "mounts": [
    "source=${localEnv:HOME}/.config/global-apikeys,target=/home/vscode/.config/global-apikeys,type=bind"
  ]
}
