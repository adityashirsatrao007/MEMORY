# ── Agent Read Cache ──────────────────────────────────────────────────────────
# Agent checks this before reading files. Append path after each read.
# Check: grep -qxF "/abs/path" /tmp/.agent-read-cache 2>/dev/null && echo "CACHED"
__ARC="/tmp/.agent-read-cache"
mark-read() { echo "$(realpath "$1")" >> "$__ARC" 2>/dev/null; }
is-read()   { grep -qxF "$(realpath "$1")" "$__ARC" 2>/dev/null; }
