#!/bin/bash
# Auto-re-vector ChromaDB when module files change (post-merge)
CHANGED=$(git diff HEAD@{1} --name-only 2>/dev/null | grep -c "memory/modules/" 2>/dev/null)
if [ "$CHANGED" -gt 0 ]; then
  . /home/aditya/.venvs/ml/bin/activate 2>/dev/null && python3 tools/seed_vector_db.py --force 2>/dev/null
fi
